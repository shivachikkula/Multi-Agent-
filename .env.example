# Copy to .env and fill in what you have. Everything is optional — with
# nothing set, the whole stack runs on the offline mock LLM and local
# fallbacks for every Azure service (see README.md "Architecture mapping").

# --- AI Gateway -------------------------------------------------------------
GATEWAY_API_KEYS=dev-local-key
GATEWAY_RATE_LIMIT_PER_MINUTE=60
# ORCHESTRATOR_FAILOVER_URL=http://orchestrator-secondary:8001

# --- Identity, Security & Governance -----------------------------------
# AZURE_TENANT_ID=
# AZURE_AD_AUDIENCE=
# AZURE_USE_MANAGED_IDENTITY=false
# AZURE_KEY_VAULT_URI=

# --- LLM & AI Services (Azure OpenAI) --------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_CONTENT_SAFETY_ENDPOINT=
# AZURE_CONTENT_SAFETY_API_KEY=

# --- Enterprise Data & Knowledge ---------------------------------------
# AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_API_KEY=
# AZURE_SEARCH_INDEX=knowledge-base
# AZURE_COSMOS_ENDPOINT=
# AZURE_COSMOS_KEY=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=documents
SQL_DATABASE_URL=postgresql+asyncpg://agent:agent@postgres:5432/agentdb

# --- Event & Async Processing -------------------------------------------
REDIS_URL=redis://redis:6379/0
# AZURE_EVENT_HUB_CONNECTION_STRING=
# AZURE_SERVICE_BUS_CONNECTION_STRING=
# AZURE_SERVICE_BUS_QUEUE=agent-tasks

# --- Observability & Monitoring -----------------------------------------
# APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=multi-agent-platform
LOG_LEVEL=INFO

# --- Tools & Connectors ---------------------------------------------------
# MCP_SERVER_URL=http://localhost:9000/sse

# --- Human in the loop ---------------------------------------------------
HITL_FINANCE_APPROVAL_THRESHOLD_USD=1000
